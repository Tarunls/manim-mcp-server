PORT=4321
APP_BASE_URL=http://127.0.0.1:4321

# Required for video generation. Usage is billed through the OpenAI API.
OPENAI_API_KEY=

# Stripe test-mode values. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional services already supported by the studio.
SPEECHIFY_API_KEY=

# ---------------------------------------------------------------------------
# Production sandboxing (E2B). When E2B_API_KEY is set, every codex session
# runs inside an isolated Firecracker sandbox instead of on this host.
# ---------------------------------------------------------------------------
E2B_API_KEY=
E2B_TEMPLATE_ID=lesson-studio-agent
E2B_MAX_CONCURRENT=20
E2B_SANDBOX_TTL=45m
E2B_SANDBOX_IDLE_TIMEOUT=5m

# ---------------------------------------------------------------------------
# Convex backend (auth, profiles, sessions registry, usage receipts).
# ---------------------------------------------------------------------------
VITE_CONVEX_URL=
CONVEX_URL=

# Set to true in hosted deployments to require sign-in for all API access.
AUTH_REQUIRED=false

# ---------------------------------------------------------------------------
# Limits & quotas. Credits approximate USD of model spend per billing period.
# ---------------------------------------------------------------------------
LIMIT_MAX_VIDEO_SECONDS=90
LIMIT_MAX_TURNS=14
LIMIT_TURN_SOFT_MS=480000
LIMIT_TURN_HARD_MS=900000
LIMIT_CONCURRENT_FREE=1
LIMIT_CONCURRENT_PAID=3
LIMIT_CREDITS_FREE=6
LIMIT_CREDITS_CREATOR=40
LIMIT_CREDITS_PRO=120
LIMIT_DAILY_SPEND_USD=250

# Model routing overrides (optional).
STUDIO_MODEL=gpt-5.6-sol
STUDIO_REASONING_EFFORT=high
