PORT=4321
APP_BASE_URL=http://127.0.0.1:4321

# Required only for hosted production builds. Protects the private test studio
# until real end-user authentication is added.
STUDIO_ACCESS_USERNAME=studio
STUDIO_ACCESS_PASSWORD=

# Required for video generation. Usage is billed through the OpenAI API.
OPENAI_API_KEY=

# Stripe test-mode values. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional services already supported by the studio.
SPEECHIFY_API_KEY=
