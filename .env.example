PORT=4321
APP_BASE_URL=http://127.0.0.1:4321
SERVICE_ROLE=all

# Required for end-user email/password accounts. Production session cookies are
# created and verified by Firebase Admin using Application Default Credentials.
IDENTITY_PLATFORM_API_KEY=
IDENTITY_PLATFORM_PROJECT_ID=
AUTH_CHECK_REVOKED=true
STAFF_EMAILS=tarun.l.sankar@gmail.com,abhinav.malkoochi@gmail.com

# PostgreSQL is mandatory in horizontally scaled deployments. Local development
# can omit it temporarily and use the legacy file store.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
REQUIRE_DATABASE=false

# Used only to irreversibly hash network identifiers in security audit events.
AUDIT_HASH_SECRET=

# Required for video generation. In hosted mode this remains on the API service;
# E2B receives only an active-job-scoped proxy token.
OPENAI_API_KEY=
CODEX_MAX_API_CALLS_PER_JOB=64
CODEX_MAX_ESTIMATED_COST_MICROUSD_PER_JOB=2000000
CODEX_UPSTREAM_TIMEOUT_MS=2700000

# Production generation runs one job per isolated E2B sandbox.
EXECUTION_MODE=local
E2B_API_KEY=
E2B_TEMPLATE=lesson-studio-renderer
E2B_TEMPLATE_VERSION=dev
E2B_MAX_CONCURRENT_SANDBOXES=20
E2B_SANDBOX_TIMEOUT_MS=2700000

# GCP queue and private artifact storage.
GCP_PROJECT=
GCP_REGION=us-central1
GENERATION_QUEUE=lesson-studio-generation
GENERATION_DISPATCH_URL=
GENERATION_DISPATCH_SERVICE_ACCOUNT=
STUDIO_ARTIFACT_BUCKET=
JOB_CALLBACK_SECRET=
JOB_CALLBACK_BASE_URL=
OUTBOX_POLL_INTERVAL_MS=5000

# Stripe test-mode values. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Deliberately leave false in public deployments. It permits sandbox checkout
# locally only when you explicitly opt in.
ALLOW_TEST_CHECKOUT=false
BILLING_MODE_REQUIRED=

# Optional persistent data location. Defaults to this repository for local use.
STUDIO_DATA_ROOT=

# Optional services already supported by the studio.
SPEECHIFY_API_KEY=
