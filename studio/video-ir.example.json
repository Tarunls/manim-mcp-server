  "beats": [
    {
      "id": "introduce-system",
      "intent": "Introduce the central idea with one strong visual hierarchy",
      "focus": "message",
      "duration": 9,
      "narration": "A strong video begins with an explicit hierarchy, so the viewer immediately knows where to look and why the relationship matters.",
      "nodes": [
        {
          "id": "panel",
          "type": "panel",
          "width": 9.5,
          "height": 4.8,
          "cornerRadius": 0.2,
          "style": { "fill": "surface", "stroke": "muted", "fillOpacity": 1 }
        },
        { "id": "headline", "type": "text", "text": "Hierarchy first", "role": "headline" },
        { "id": "message", "type": "text", "text": "One focal relationship", "role": "body", "color": "accent" },
        {
          "id": "content",
          "type": "group",
          "children": ["headline", "message"],
          "layout": "column",
          "gap": "md",
          "align": "center"
        }
      ],
      "constraints": [
        { "type": "anchor", "target": "panel", "anchor": "center" },
        { "type": "inside", "target": "content", "container": "panel", "padding": "lg" }
      ],
      "cues": [
        { "start": 0, "duration": 1, "action": "fadeIn", "targets": ["panel"] },
        { "start": 1, "duration": 1, "action": "write", "targets": ["content"] },
        { "start": 2.5, "duration": 1, "action": "indicate", "targets": ["message"] },
