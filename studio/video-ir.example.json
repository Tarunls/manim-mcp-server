{
  "schemaVersion": "0.2",
  "format": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "background": "background",
    "safeArea": 0.32
  },
  "theme": {
    "fontFamily": "DejaVu Sans",
    "palette": {
      "background": "#F6F5F2",
      "surface": "#FFFFFF",
      "text": "#17202A",
      "muted": "#AAB2BD",
      "accent": "#4C6FFF"
    },
    "spacing": { "sm": 0.18, "md": 0.32, "lg": 0.5 },
    "textStyles": {
      "headline": { "fontSize": 52, "color": "text", "weight": "BOLD" },
      "body": { "fontSize": 31, "color": "text", "weight": "NORMAL" },
      "caption": { "fontSize": 22, "color": "muted", "weight": "MEDIUM" }
    },
    "motion": {
      "durations": { "fast": 0.4, "base": 0.8, "slow": 1.2 },
      "distance": 0.6,
      "defaultEase": "smooth"
    }
  },
  "beats": [
    {
      "id": "introduce-system",
      "intent": "Introduce the central idea with one strong visual hierarchy",
      "focus": "message",
      "duration": 9,
      "transition": { "style": "push", "duration": "slow", "direction": "left", "distance": 0.7 },
      "narration": "A strong video begins with an explicit hierarchy, so the viewer immediately knows where to look and why the relationship matters.",
      "nodes": [
        {
          "id": "panel",
          "type": "panel",
          "width": 9.5,
          "height": 4.8,
          "cornerRadius": 0.2,
          "style": { "fill": "surface", "stroke": "muted", "fillOpacity": 1 }
        },
        { "id": "headline", "type": "text", "text": "Hierarchy first", "role": "headline" },
        { "id": "message", "type": "text", "text": "One focal relationship", "role": "body", "color": "accent" },
        {
          "id": "content",
          "type": "group",
          "children": ["headline", "message"],
          "layout": "column",
          "gap": 0.9,
          "align": "center"
        },
        {
          "id": "relationship",
          "type": "connector",
          "from": "headline",
          "to": "message",
          "kind": "arrow",
          "color": "accent",
          "strokeWidth": 3,
          "buff": "sm"
        }
      ],
      "constraints": [
        { "type": "anchor", "target": "panel", "anchor": "center" },
        { "type": "inside", "target": "content", "container": "panel", "padding": "lg" }
      ],
      "cues": [
        { "start": 0, "duration": "base", "action": "slideIn", "targets": ["panel"], "direction": "down" },
        { "start": 0.8, "duration": "slow", "action": "write", "targets": ["content"] },
        { "start": 2, "duration": "fast", "action": "draw", "targets": ["relationship"] },
        { "start": 2.8, "duration": "base", "action": "circumscribe", "targets": ["message"], "color": "accent" },
        { "start": 4, "duration": "fast", "action": "flash", "targets": ["message"] },
        { "start": 4.8, "duration": "slow", "action": "wiggle", "targets": ["message"] },
        { "start": 6.6, "duration": "base", "action": "indicate", "targets": ["message"] }
      ]
    },
    {
      "id": "enforce-layout",
      "intent": "Show that relationships are constraints rather than guessed coordinates",
      "focus": "message",
      "duration": 9,
      "transition": { "style": "morph", "duration": "slow" },
      "narration": "Relational constraints replace guessed coordinates, letting the compiler prove containment, spacing, and safe margins before expensive rendering ever begins.",
      "nodes": [
        {
          "id": "panel",
          "type": "panel",
          "width": 9.5,
          "height": 4.8,
          "style": { "fill": "surface", "stroke": "accent", "fillOpacity": 1 }
        },
        { "id": "headline", "type": "text", "text": "Constraints, not coordinates", "role": "headline" },
        { "id": "message", "type": "text", "text": "anchor → contain → verify", "role": "body", "color": "accent" },
        {
          "id": "content",
          "type": "group",
          "children": ["headline", "message"],
          "layout": "column",
          "gap": 0.9,
          "align": "center"
        },
        {
          "id": "relationship",
          "type": "connector",
          "from": "headline",
          "to": "message",
          "kind": "arrow",
          "color": "accent",
          "strokeWidth": 3,
          "buff": "sm"
        }
      ],
      "constraints": [
        { "type": "anchor", "target": "panel", "anchor": "center" },
        { "type": "inside", "target": "content", "container": "panel", "padding": "lg" }
      ],
      "cues": [
        { "start": 0, "duration": "base", "action": "circumscribe", "targets": ["panel"] },
        { "start": 1.2, "duration": "slow", "action": "wiggle", "targets": ["headline", "message"], "stagger": 0.18 },
        { "start": 2.8, "duration": "fast", "action": "flash", "targets": ["message"] },
        { "start": 3.6, "duration": "base", "action": "indicate", "targets": ["relationship"] },
        { "start": 4.8, "duration": "base", "action": "circumscribe", "targets": ["message"] },
        { "start": 6, "duration": "slow", "action": "wiggle", "targets": ["message"] }
      ]
    },
    {
      "id": "direct-attention",
      "intent": "Connect reliable geometry to deliberate motion and pacing",
      "focus": "message",
      "duration": 8.4,
      "narration": "Once geometry is reliable, motion can direct attention instead of hiding layout mistakes, producing videos that feel deliberate rather than merely decorated.",
      "nodes": [
        {
          "id": "panel",
          "type": "panel",
          "width": 9.5,
          "height": 4.8,
          "style": { "fill": "surface", "stroke": "muted", "fillOpacity": 1 }
        },
        { "id": "headline", "type": "text", "text": "Motion directs attention", "role": "headline" },
        {
          "id": "message",
          "type": "text",
          "text": "Precision becomes a creative primitive",
          "role": "body",
          "color": "accent",
          "maxWidth": 4.8,
          "minFontSize": 24,
          "lineSpacing": 0.16,
          "align": "center"
        },
        {
          "id": "content",
          "type": "group",
          "children": ["headline", "message"],
          "layout": "column",
          "gap": 0.9,
          "align": "center"
        },
        {
          "id": "relationship",
          "type": "connector",
          "from": "headline",
          "to": "message",
          "kind": "arrow",
          "color": "accent",
          "strokeWidth": 3,
          "buff": "sm"
        }
      ],
      "constraints": [
        { "type": "anchor", "target": "panel", "anchor": "center" },
        { "type": "inside", "target": "content", "container": "panel", "padding": "lg" }
      ],
      "cues": [
        { "start": 0, "duration": "base", "action": "circumscribe", "targets": ["panel"] },
        { "start": 1.2, "duration": "slow", "action": "wiggle", "targets": ["message"] },
        { "start": 2.8, "duration": "fast", "action": "flash", "targets": ["message"] },
        { "start": 3.6, "duration": "base", "action": "indicate", "targets": ["relationship"] },
        { "start": 4.8, "duration": "base", "action": "circumscribe", "targets": ["message"] },
        { "start": 6, "duration": "slow", "action": "wiggle", "targets": ["message"] },
        { "start": 7.6, "duration": "fast", "action": "indicate", "targets": ["message"] }
      ]
    }
  ]
}
