{
  "name": "manim-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "build": "vite build && tsc --noEmit",
    "start": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "check": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate_database.ts",
    "e2b:build-template": "node --env-file-if-exists=.env --import tsx scripts/build_e2b_template.ts",
    "smoke:e2b": "node --env-file-if-exists=.env --import tsx scripts/smoke_e2b.ts",
    "smoke:identity": "node --env-file-if-exists=.env --import tsx scripts/smoke_identity.ts",
    "smoke:stripe": "node --env-file-if-exists=.env --import tsx scripts/smoke_stripe.ts",
    "smoke:staging": "node --env-file-if-exists=.env --import tsx scripts/smoke_staging_e2e.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "setup:manim": "node scripts/setup_manim.mjs",
    "stripe:setup": "node scripts/setup_stripe.mjs",
    "stripe:listen": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed --forward-to http://127.0.0.1:4321/api/stripe/webhook",
    "stripe:cloud-webhook": "node scripts/configure_cloud_run_webhook.mjs",
    "identity:setup": "node scripts/setup_identity_platform.mjs",
    "gcp:storage": "node scripts/setup_cloud_storage.mjs",
    "render:marketing-reel": "node scripts/render_marketing_reel.mjs"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/manrope": "^5.2.7",
    "@google-cloud/storage": "^8.0.1",
    "@google-cloud/tasks": "^7.0.0",
    "@openai/codex": "^0.147.0",
    "@openai/codex-sdk": "^0.149.1",
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/bundler": "^4.0.514",
    "@remotion/renderer": "^4.0.514",
    "@speechify/api": "^4.0.1",
    "e2b": "^2.45.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.514",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@remotion/cli": "^4.0.514",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "overrides": {
    "firebase-admin": {
      "@google-cloud/storage": "8.0.1"
    },
    "uuid": "11.1.1"
  }
}
