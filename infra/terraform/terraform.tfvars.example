project_id           = "educationalvideo-506219"
region               = "us-central1"
environment          = "staging"
billing_mode         = "auto"
image                = "us-central1-docker.pkg.dev/educationalvideo-506219/lesson-studio/app:<immutable-commit-sha>"
app_base_url         = ""
app_domain           = ""
enable_external_edge = false
e2b_template_version = "<immutable-release-id>"

max_concurrent_sandboxes = 2
api_max_instances         = 3
sql_tier                 = "db-f1-micro"
sql_availability_type    = "ZONAL"
sql_disk_size_gb         = 10
billing_account_id       = "0181BB-902BC6-5D4673"
monthly_budget_usd       = 20

# Codex budget: cost is the primary enforced ceiling; the call count is a backstop.
codex_max_api_calls_per_job               = 200
codex_max_estimated_cost_microusd_per_job = 2000000

secret_ids = {
  identity_api_key   = "identity_platform_api_key"
  openai_api_key     = "openai_api_key"
  e2b_api_key        = "e2b_api_key"
  speechify_api_key  = "speechify_key"
  elevenlabs_api_key = "elevenlabs_api_key"
  stripe_api_key     = "stripe_sandbox_api_key"
  stripe_webhook     = "stripe_webhook_secret"
  staff_emails       = "staff_emails"
}

# To promote an already domain-enabled stack to real payments without renaming
# infrastructure, set billing_mode = "live" and replace the two Stripe values
# inside secret_ids with stripe_live_api_key and stripe_live_webhook_secret.

# Email channel managed by Terraform; extra pre-existing channel IDs can be appended below.
alert_email              = "alerts@example.com"
notification_channel_ids = []
